{
  "name": "portfolio-blog-server",
  "version": "1.0.0",
  "description": "Portfolio blog server with REST API",
  "main": "server.ts",
  "scripts": {
    "start": "node --import tsx server.ts",
    "dev": "nodemon --exec \"node --import tsx\" server.ts",
    "setup:db": "node --import tsx scripts/setup-database.ts",
    "migrate": "node --import tsx scripts/setup-database.ts",
    "migrate:content": "node --import tsx migrations/content-migration.ts",
    "migrate:ip": "node --import tsx scripts/run-ip-useragent-migration.ts",
    "sessions:cleanup": "node --import tsx scripts/cleanup-admin-sessions.ts",
    "check": "node --import tsx scripts/check.ts",
    "check:types": "tsc --noEmit --pretty false",
    "check:mcp": "npm --prefix mcp run smoke",
    "typecheck": "npm run check:types",
    "test:unit": "node --import tsx --test tests/*.test.js",
    "test": "npm run check && npm run check:types && npm run test:unit",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart portfolio-server",
    "pm2:stop": "pm2 stop portfolio-server",
    "pm2:logs": "pm2 logs portfolio-server --lines 80",
    "pm2:status": "pm2 list",
    "pm2:save": "pm2 save",
    "pm2:startup": "pm2 startup"
  },
  "keywords": [
    "blog",
    "portfolio",
    "express",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.6.5",
    "node-cache": "^5.1.2",
    "redis": "^5.8.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.22.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^26.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
